generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resume         Resume?
  jobMatches     JobMatch[]
  careerInsights CareerInsight[]
}

model Resume {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  content           String // Raw resume text/JSON
  yearsOfExperience Int?
  educationLevel    String? // Bachelor's, Master's, PhD, etc.
  skillTags         String[] // Array of skills

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobListing {
  id          String @id @default(cuid())
  title       String
  company     String
  description String
  url         String @unique
  source      String // "TokyoDev" or "JapanDev"

  requiredJLPT    String? // N1, N2, N3, N4, etc.
  visaSponsorship Boolean?
  salary          String?
  location        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  insights JobInsight?
  matches  JobMatch[]
}

model JobInsight {
  id           String     @id @default(cuid())
  jobListingId String     @unique
  jobListing   JobListing @relation(fields: [jobListingId], references: [id], onDelete: Cascade)

  skillMatch          Float? // Percentage match 0-100
  visaPath            String? // Analysis of visa eligibility
  languageRequirement String? // Required JLPT level analysis
  keySkillsNeeded     String[] // Extracted skills from job
  careerProgression   String? // Career growth potential

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobMatch {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobListingId String
  jobListing   JobListing @relation(fields: [jobListingId], references: [id], onDelete: Cascade)

  matchScore     Float // Overall match percentage
  matchReasoning String? // Claude's explanation of why this is a good match
  visaEligible   Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobListingId])
}

model CareerInsight {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  insight           String // Claude-generated career pathway/recommendation
  nextSteps         String[] // Actionable recommendations
  estimatedTimeline String? // "6 months", "1 year", etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}